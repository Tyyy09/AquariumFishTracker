@{
    ViewData["Title"] = "Home";
}
<!--Redesign HomePage-->
<div class="container mt-5">
    <div class="card shadow-sm border-0">
        <div class="card-body text-center p-5">

            <h1 class="display-4 mb-3 text-primary">Welcome to AquariumFishTracker</h1>

            <p class="lead">
                AquariumFishTracker is a simple ASP.NET Core MVC application that helps users
                manage aquarium tanks and the fish that live in them. You can create, view,
                update, and delete tank records, as well as track the fish associated with each tank.
            </p>

            <hr class="my-4" />

            <p class="text-muted">
                This project demonstrates core MVC concepts including models, controllers, views,
                database integration, and CRUD operations using SQL Server.
            </p>

        </div>
    </div>
</div>

<!--Adding Traking Dashboard-->
@{
    ViewData["Title"] = "Dashboard";
}
<div class="container mt-4">

    <h1 class="mb-4 text-center fw-bold">Aquarium Dashboard</h1>

    <div class="row g-4">

        <div class="col-md-3">
            <div class="card shadow-sm text-center p-3">
                <h4>Total Fish</h4>
                <p class="display-6">@ViewBag.TotalFish</p>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm text-center p-3">
                <h4>Total Tanks</h4>
                <p class="display-6">@ViewBag.TotalTanks</p>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm text-center p-3">
                <h4>Average pH</h4>
                <p class="display-6">@ViewBag.AvgPH.ToString("0.0")</p>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm text-center p-3">
                <h4>Tanks Needing Cleaning</h4>
                <p class="display-6">@ViewBag.TanksNeedingCleaning</p>
            </div>
        </div>

    </div>

    <div class="text-center mt-4">
        <a asp-controller="Fish" asp-action="Create" class="btn btn-primary me-2">Add Fish</a>
        <a asp-controller="Tanks" asp-action="Create" class="btn btn-success">Add Tank</a>
    </div>

</div>
