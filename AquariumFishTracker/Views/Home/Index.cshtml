@{
    ViewData["Title"] = "Home";
}

<!-- Hero -->
<div style="background:#042C53; border-radius:12px; padding:2.5rem 2rem; margin-bottom:1.5rem; position:relative; overflow:hidden;">
    <p style="font-size:11px; letter-spacing:0.15em; text-transform:uppercase; color:#85B7EB; margin-bottom:0.5rem;">ASP.NET Core MVC · SQL Server</p>
    <h1 style="font-size:2.2rem; font-weight:700; color:#fff; margin-bottom:0.75rem; line-height:1.2;">
        Aquarium <span style="color:#5DCAA5;">Fish Tracker</span>
    </h1>
    <p style="color:#B5D4F4; font-size:15px; max-width:520px; line-height:1.7;">
        Manage your tanks and the fish inside them. Full CRUD backed by SQL Server.
    </p>
</div>

<!-- Stats -->
<div style="display:grid; grid-template-columns:repeat(4,1fr); gap:12px; margin-bottom:1.5rem;">

    <div style="background:#fff; border:0.5px solid #e0e0e0; border-radius:12px; padding:1.25rem 1rem; border-top:3px solid #1D9E75;">
        <p style="font-size:11px; text-transform:uppercase; letter-spacing:0.08em; color:#888; margin-bottom:0.4rem;">Total Fish</p>
        <p style="font-size:2rem; font-weight:700; color:#111; line-height:1;">@ViewBag.TotalFish</p>
        <p style="font-size:12px; color:#aaa; margin-top:0.25rem;">in all tanks</p>
    </div>

    <div style="background:#fff; border:0.5px solid #e0e0e0; border-radius:12px; padding:1.25rem 1rem; border-top:3px solid #185FA5;">
        <p style="font-size:11px; text-transform:uppercase; letter-spacing:0.08em; color:#888; margin-bottom:0.4rem;">Total Tanks</p>
        <p style="font-size:2rem; font-weight:700; color:#111; line-height:1;">@ViewBag.TotalTanks</p>
        <p style="font-size:12px; color:#aaa; margin-top:0.25rem;">registered</p>
    </div>

    <div style="background:#fff; border:0.5px solid #e0e0e0; border-radius:12px; padding:1.25rem 1rem; border-top:3px solid #BA7517;">
        <p style="font-size:11px; text-transform:uppercase; letter-spacing:0.08em; color:#888; margin-bottom:0.4rem;">Avg pH</p>
        <p style="font-size:2rem; font-weight:700; color:#111; line-height:1;">@ViewBag.AvgPH.ToString("0.0")</p>
        <p style="font-size:12px; color:#aaa; margin-top:0.25rem;">across tanks</p>
    </div>

    <div style="background:#fff; border:0.5px solid #e0e0e0; border-radius:12px; padding:1.25rem 1rem; border-top:3px solid #E24B4A;">
        <p style="font-size:11px; text-transform:uppercase; letter-spacing:0.08em; color:#888; margin-bottom:0.4rem;">Need Cleaning</p>
        <p style="font-size:2rem; font-weight:700; color:#111; line-height:1;">@ViewBag.TanksNeedingCleaning</p>
        <p style="font-size:12px; color:#aaa; margin-top:0.25rem;">tanks flagged</p>
    </div>

</div>

<!-- Actions + About -->
<div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">

    <div style="background:#fff; border:0.5px solid #e0e0e0; border-radius:12px; padding:1.25rem;">
        <p style="font-size:12px; text-transform:uppercase; letter-spacing:0.1em; color:#888; margin-bottom:1rem; padding-bottom:0.65rem; border-bottom:0.5px solid #e0e0e0;">Quick Actions</p>
        <div style="display:flex; flex-direction:column; gap:8px;">
            <a asp-controller="Fish" asp-action="Create" class="btn btn-outline-success btn-sm">+ Add Fish</a>
            <a asp-controller="Tanks" asp-action="Create" class="btn btn-outline-primary btn-sm">+ Add Tank</a>
            <a asp-controller="Fish" asp-action="Index" class="btn btn-outline-secondary btn-sm">View All Fish</a>
            <a asp-controller="Tanks" asp-action="Index" class="btn btn-outline-secondary btn-sm">View All Tanks</a>
        </div>
    </div>

    <div style="background:#fff; border:0.5px solid #e0e0e0; border-radius:12px; padding:1.25rem;">
        <p style="font-size:12px; text-transform:uppercase; letter-spacing:0.1em; color:#888; margin-bottom:1rem; padding-bottom:0.65rem; border-bottom:0.5px solid #e0e0e0;">About</p>
        <ul style="font-size:13px; color:#555; line-height:2; padding-left:1.1rem;">
            <li>Track fish and tanks with full CRUD</li>
            <li>Each fish is linked to a parent tank</li>
            <li>Tank cleaning flagged after 14 days</li>
            <li>Built with ASP.NET Core MVC + EF Core</li>
        </ul>
    </div>

</div>