@model AquariumFishTracker.Models.Fish

@{
    ViewData["Title"] = "Delete Fish";
}

<div class="container mt-4" style="max-width:520px;">

    <h1 class="fw-bold mb-4 text-danger">Delete Fish</h1>

    <div class="card border-danger shadow-sm">
        <div class="card-body p-4">

            <p class="mb-4">Are you sure you want to delete this fish? This cannot be undone.</p>

            <table class="table table-sm table-borderless mb-4">
                <tr><th style="width:40%">Name</th><td>@Model.Name</td></tr>
                <tr><th>Species</th><td>@Model.Species</td></tr>
                <tr><th>Length</th><td>@Model.LengthCm cm</td></tr>
                <tr><th>Weight</th><td>@Model.WeightGrams g</td></tr>
                <tr><th>Date Added</th><td>@Model.DateAdded.ToShortDateString()</td></tr>
                <tr><th>Tank</th><td>@(Model.Tank?.Name ?? "Unassigned")</td></tr>
            </table>

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>

        </div>
    </div>

</div>