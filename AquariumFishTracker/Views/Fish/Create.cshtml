@model AquariumFishTracker.Models.Fish

<div class="container mt-4">

    <h1 class="fw-bold mb-4">Create Fish</h1>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-action="Create">

                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Species" class="form-label"></label>
                    <input asp-for="Species" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="LengthCm" class="form-label"></label>
                    <input asp-for="LengthCm" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="WeightGrams" class="form-label"></label>
                    <input asp-for="WeightGrams" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="TankId" class="form-label">Tank</label>
                    <select asp-for="TankId" asp-items="ViewBag.TankId" class="form-select">
                        <option value="">-- Select Tank --</option>
                    </select>
                </div>

                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>

            </form>

        </div>
    </div>

</div>
