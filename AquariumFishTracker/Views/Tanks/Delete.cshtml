@model AquariumFishTracker.Models.Tank

@{
    ViewData["Title"] = "Delete Tank";
}

<div class="container mt-4" style="max-width:520px;">

    <h1 class="fw-bold mb-4 text-danger">Delete Tank</h1>

    <div class="card border-danger shadow-sm">
        <div class="card-body p-4">

            <p class="mb-4">Are you sure you want to delete this tank? This cannot be undone.</p>

            <table class="table table-sm table-borderless mb-4">
                <tr><th style="width:40%">Name</th><td>@Model.Name</td></tr>
                <tr><th>Volume</th><td>@Model.VolumeLiters L</td></tr>
                <tr><th>Temperature</th><td>@Model.TemperatureC °C</td></tr>
                <tr><th>pH</th><td>@Model.PH</td></tr>
                <tr><th>Ammonia</th><td>@Model.Ammonia</td></tr>
                <tr><th>Nitrite</th><td>@Model.Nitrite</td></tr>
                <tr><th>Nitrate</th><td>@Model.Nitrate</td></tr>
                <tr>
                    <th>Last Cleaned</th>
                    <td>@(Model.LastCleanedDate?.ToShortDateString() ?? "Not recorded")</td>
                </tr>
            </table>

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>

        </div>
    </div>

</div>