<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AquariumFishTracker</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AquariumFishTracker.styles.css" asp-append-version="true" />

    <style>
            .aft-nav {
                background: #042C53;
                padding: 0 1.5rem;
            }

            .aft-brand {
                font-size: 16px;
                font-weight: 700;
                color: #5DCAA5 !important;
                letter-spacing: 0.03em;
                text-decoration: none;
                display: flex;
                align-items: center;
                gap: 8px;
            }

            .aft-nav .nav-link {
                color: #B5D4F4 !important;
                font-size: 13px;
                font-weight: 500;
                padding: 1.4rem 1rem !important;
                border-bottom: 2px solid transparent;
                transition: color 0.15s, border-color 0.15s;
            }

                .aft-nav .nav-link:hover {
                    color: #fff !important;
                    border-bottom: 2px solid #5DCAA5;
                }

                .aft-nav .nav-link.active {
                    color: #fff !important;
                    border-bottom: 2px solid #5DCAA5;
                }

            .aft-nav .navbar-toggler {
                border-color: rgba(255,255,255,0.2);
            }

            .aft-nav .navbar-toggler-icon {
                filter: invert(1);
            }

            .nav-divider {
                width: 1px;
                height: 20px;
                background: rgba(255,255,255,0.1);
                margin: auto 8px;
            }
    </style>
</head>

<body style="background:#f5f7fa; min-height:100vh; display:flex; flex-direction:column;">

    <header>
        <nav class="navbar navbar-expand-sm aft-nav">
            <div class="container-fluid">

                <a class="aft-brand" asp-controller="Home" asp-action="Index">
                    AquariumFishTracker
                </a>

                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1" style="padding-left:1.5rem;">

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Tanks" asp-action="Index">Tanks</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Fish" asp-action="Index">Fish</a>
                        </li>

                        <div class="nav-divider"></div>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="About">About</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>

                    </ul>

                    <partial name="_LoginPartial" />
                </div>

            </div>
        </nav>
    </header>

    <div class="container flex-grow-1 mt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer style="background:#042C53; color:#85B7EB; padding:1rem 0; margin-top:2rem;">
        <div class="container" style="font-size:13px;">
            &copy; 2026 - AquariumFishTracker |
            Created by: <strong style="color:#5DCAA5;">Ichty Te</strong> |
            Student #: <strong style="color:#fff;">200626964</strong> |
            COMP 2084 – Server-Side Scripting
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>