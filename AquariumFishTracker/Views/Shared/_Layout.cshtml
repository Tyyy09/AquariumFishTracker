<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AquariumFishTracker</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AquariumFishTracker.styles.css" asp-append-version="true" />
</head>

<body style="background:#f5f7fa; min-height:100vh; display:flex; flex-direction:column;">

    <header>
        <nav class="navbar navbar-expand-sm navbar-dark mb-3"
             style="background:#042C53; box-shadow:0 2px 8px rgba(0,0,0,0.15);">
            <div class="container-fluid">

                <!-- Brand -->
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index"
                       style="color:#5DCAA5; letter-spacing:0.03em;">
                    AquariumFishTracker
                </a>

                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index"
                               style="color:#B5D4F4;">Home</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Tanks" asp-action="Index"
                               style="color:#B5D4F4;">Tanks</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Fish" asp-action="Index"
                               style="color:#B5D4F4;">Fish</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="About"
                               style="color:#B5D4F4;">About</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Privacy"
                               style="color:#B5D4F4;">Privacy</a>
                        </li>

                    </ul>

                    <partial name="_LoginPartial" />
                </div>

            </div>
        </nav>
    </header>

    <div class="container flex-grow-1">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer style="background:#042C53; color:#85B7EB; padding:1rem 0; margin-top:2rem;">
        <div class="container" style="font-size:13px;">
            &copy; 2026 - AquariumFishTracker |
            Created by: <strong style="color:#5DCAA5;">Ichty Te</strong> |
            Student #: <strong style="color:#fff;">200626964</strong> |
            COMP 2084 – Server-Side Scripting
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>